# MetaApi Cloud credentials. Keep real values only in local/deployment secrets.
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Explicit safety defaults. The scaffold cannot place orders.
TRADING_MODE=disabled
ALLOW_ORDER_SUBMISSION=false
ALLOW_LIVE_TRADING=false

# Set actual broker symbol names only after checking MetaApi account metadata.
SYMBOLS=XAUUSD
MAX_SPREAD_POINTS=0
MAX_RISK_PER_TRADE_PERCENT=0.25
MAX_DAILY_LOSS_PERCENT=1.0
MAX_OPEN_POSITIONS=1
